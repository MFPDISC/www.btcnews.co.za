# www.btcnews.co.za Environment Variables
# Copy this file to .env.local and fill in any necessary values

# Database
DATABASE_URL="./data/bitcoin.db"

# API Configuration
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
BINANCE_API_URL="https://api.binance.com/api/v3"

# Development
NODE_ENV="development"
PORT=3001

# Admin Dashboard
ADMIN_PASSWORD="Platinum@0181"

# Analytics
NEXT_PUBLIC_GA_ID="GA_MEASUREMENT_ID"

# Add your API keys here if needed
# COINGECKO_API_KEY="" (free public endpoints)
# - TradingView widgets (embedded)

# Database Configuration
# SQLite database stored in: /data/bitcoin.db
# Automatically stores price snapshots every 30 seconds
# Hourly prices stored for historical analysis
